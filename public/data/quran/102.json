[{"surah":102,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"},{"surah":102,"ayah":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"},{"surah":102,"ayah":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"surah":102,"ayah":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"},{"surah":102,"ayah":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"},{"surah":102,"ayah":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ"},{"surah":102,"ayah":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"},{"surah":102,"ayah":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}]